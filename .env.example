# Groq Cloud API Key (Get your free key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Vision Model (llama-3.2-11b-vision-preview or llama-3.2-90b-vision-preview)
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Engine Mode: groq | ollama | transformers
SATQUERY_ENGINE_MODE=groq
